{
  "name": "@allon2/dsh-github-mcp",
  "version": "1.0.2",
  "description": "GitHub 官方远程 MCP 服务器接入:为 DeepSeek Harness 提供 Issue、Pull Request、仓库搜索等 46 个 GitHub 工具。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "github",
    "mcp",
    "issues",
    "pull-request",
    "repository"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allon2/dsh-github-mcp.git"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.0"
  },
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
